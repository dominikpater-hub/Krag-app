# Krąg — produkcja. Skopiuj do .env obok docker-compose.prod.yml i uzupełnij. NIE commituj .env.
PGUSER=krag
PGPASSWORD=ZMIEN_NA_DLUGIE_LOSOWE_HASLO
PGDATABASE=krag

# Domena API (rekord A wskazuje na IP serwera). Caddy weźmie na nią certyfikat HTTPS.
API_DOMAIN=api.krag.example

# Origin(y) PWA, które mogą wołać API (przez przecinek). Musi pasować do adresu apki.
CORS_ORIGINS=https://projectkrag.vercel.app

# Sekret do podpisywania wyzwań proof-of-work (dowolny długi losowy ciąg).
POW_SECRET=ZMIEN_NA_DLUGI_LOSOWY_SEKRET
POW_BITS=18
